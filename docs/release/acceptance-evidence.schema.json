{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendelegate.dev/schemas/release/acceptance-evidence.schema.json",
  "title": "OpenDelegate first-milestone acceptance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "milestone",
    "auditedAt",
    "sourceCommit",
    "releaseStatus",
    "criteria"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "product": { "const": "OpenDelegate" },
    "milestone": { "const": "first" },
    "auditedAt": { "type": "string", "format": "date-time" },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "releaseStatus": { "enum": ["blocked", "candidate", "released"] },
    "candidateAttestation": { "$ref": "#/$defs/proof" },
    "criteria": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "implementationStatus",
          "liveProofStatus",
          "evidence",
          "nextGate"
        ],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 36 },
          "title": { "type": "string", "minLength": 1 },
          "implementationStatus": { "enum": ["missing", "partial", "verified"] },
          "liveProofStatus": {
            "enum": ["not-run", "blocked-external", "verified"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "nextGate": { "type": "string", "minLength": 1 }
          ,
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "implementation": { "$ref": "#/$defs/proof" },
              "liveProof": { "$ref": "#/$defs/proof" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "attestationId", "evidence"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "attestationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{7,255}$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceReference" }
        }
      }
    }
  }
}
